# Safe application mode. Keep these values for implementation and empty UI work.
# empty | fixtures | provisional | ready
DATA_MODE=provisional
ALLOW_EXTERNAL_CALLS=false
ENABLE_RUNTIME_LLM=true
NEXT_TELEMETRY_DISABLED=1

# Source-specific approval remains disabled until reviewed on the destination computer.
REDDIT_SOURCE_APPROVAL=disabled

# Copilot AI answers (optional). Paste a free Google AI Studio key and restart to
# enable Gemini-written answers; leave blank to keep evidence-based answers.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyDnEqcokX8v0cZZv2bOlakyhaMm6QGN8UM
# Optional model override (comma-separated, tried in order). Default:
# gemini-2.5-flash,gemini-2.5-flash-lite,gemini-flash-latest
# GEMINI_MODEL=
YOUTUBE_API_KEY=
APIFY_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Use a truthful value such as: script:myntra-decision-intelligence:1.3.0 (by /u/yourname)
REDDIT_USER_AGENT=
